# Test-mode environment variables (Vitest runs with Vite mode = "test").
# These are DUMMY public values only — never real secrets. They exist so
# `npm test` works in CI, where the real `.env` / `.env.local` (gitignored,
# developer-local) are absent. `src/config/env.ts` fails fast if
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are missing, and Vite only loads
# `.env.production` in production mode — not in test mode.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_PUBLIC_SUPABASE_URL=https://test.supabase.co
VITE_PUBLIC_APP_URL=https://faqify.app