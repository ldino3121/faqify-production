# Razorpay Configuration (Add your actual keys)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Public app URL — used for absolute og:image / canonical URLs and embed codes.
VITE_PUBLIC_APP_URL=https://faqify.app
APP_URL=https://faqify.app

# Optional bot protection (Cloudflare Turnstile) — PUBLIC site key.
# The site key is not a secret (it ships in the JS bundle anyway); it is
# committed here so the Vercel build always includes it. The matching SECRET
# key lives only in Supabase Auth -> Bot Protection (never in this repo).
# Pair-deploy rule: frontend site key goes live BEFORE enabling the secret
# server-side, so no user is ever asked for a token the backend can't verify.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFOmQhS8M3damKIx

# Production Mode
NODE_ENV=production
